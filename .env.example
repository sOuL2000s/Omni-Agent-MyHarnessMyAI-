# Size: ~2.2 KB

# ---- Model gateway (OmniRoute, OpenRouter, Ollama, OpenAI... any OpenAI-compatible URL)
# These three are a FALLBACK provider: they are only used when data/providers.json
# does not exist yet. Add real keys through the web UI or `/add` instead.
AGENT_BASE_URL=http://localhost:20128/v1
AGENT_API_KEY=
AGENT_MODEL=auto/best-coding

# Values already exported in your shell take precedence over this file
# (config.py uses os.environ.setdefault). Delete the shell export or
# override it in .env if you need to change something.

# ---- Agent behaviour
# Workspace: the folder relative paths resolve against. Leave empty to use your home folder.
# The agent can still access the whole PC (it asks for approval unless AGENT_AUTO_APPROVE=1).
# A filesystem root (/ or C:\) is refused at startup.
AGENT_WORKSPACE=
AGENT_ALLOW_OUTSIDE=1            # 1 = allow file access anywhere on the PC (asks for approval)
AGENT_AUTO_APPROVE=             # 1 = never ask before shell/writes (use with care!)
                                 # Setting this to 1 also starts the web UI with
                                 # auto-approve ON for every new chat session.
                                 # The per-session toggle in the header can still
                                 # turn it off for an individual chat.
AGENT_STRICT=1                   # 1 = verify factual claims in answers to reduce hallucination
AGENT_MAX_TURNS=60
AGENT_TEMPERATURE=0.2
AGENT_TIMEOUT=180

# ---- Key rotation / failover (all optional; the UI and /strategy can change these too)
# AGENT_STRATEGY=round_robin       # round_robin = spread calls over all keys of a service | failover = use keys in order
# AGENT_MAX_WAIT=90                # seconds to wait for a rate-limited key to free up before giving up
# AGENT_UI_TOKEN=                  # fixed token for the web UI link (default: random each start)

# ---- Web/browser
# Selenium is opt-in. web_fetch uses urllib by default (fast, no Chrome).
# Set AGENT_BROWSER=selenium to render JavaScript pages with a headless Chrome.
# AGENT_BROWSER=selenium

# The launcher GUI opens when omni.exe is started with no arguments.
# To skip it and go straight to the terminal, either run `omni.exe chat`
# or set OMNI_NO_GUI=1 (the launcher checks this too).
# OMNI_NO_GUI=1