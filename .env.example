# ---- Model gateway (OmniRoute, OpenRouter, Ollama, OpenAI... any OpenAI-compatible URL)
AGENT_BASE_URL=http://localhost:20128/v1
AGENT_API_KEY=sk-your-omniroute-key
AGENT_MODEL=auto/best-coding

# ---- Agent behaviour
AGENT_WORKSPACE=./workspace      # the folder the agent may read/write
AGENT_ALLOW_OUTSIDE=0            # 1 = allow file access outside the workspace (asks approval)
AGENT_AUTO_APPROVE=0             # 1 = never ask before shell/writes (use with care!)
AGENT_MAX_TURNS=40
AGENT_TEMPERATURE=0.2
AGENT_TIMEOUT=180

# ---- Key rotation / failover (all optional; the UI and /strategy can change these too)
# AGENT_STRATEGY=round_robin       # round_robin = spread calls over all keys of a service | failover = use keys in order
# AGENT_MAX_WAIT=90                # seconds to wait for a rate-limited key to free up before giving up
# AGENT_UI_TOKEN=                  # fixed token for the web UI link (default: random each start)
